# Copy to .env next to compose.yaml.

# Required: the password for JupyterLab (everyone editing together uses the same one).
JUPYTER_TOKEN=change-me

# Run as your user so files in the checkout and work/ stay yours (`id -u`, `id -g`).
UID=1000
GID=1000

# Where ports listen. 127.0.0.1 = this machine only. Set your Tailscale IP (tailscale ip -4)
# to reach the lab from your other devices, or 0.0.0.0 for the whole LAN.
BIND=127.0.0.1
LAB_PORT=8888
TB_PORT=6006
SIM_PORT=8080
PAD_PORT=8081

# Interactive simulator: the walking policy (a path inside the container, e.g. /work/runs/...) and camera mount.
SIM_POLICY=/opt/Open_Duck_Mini/BEST_WALK_ONNX_2.onnx
SIM_MOUNT=head

# Datasets, runs, videos and model caches.
WORK_DIR=./work

# CPU-only machine: smaller image, no CUDA jax.
# JAX=jax==0.8.0

# NVIDIA GPU: use both compose files.
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml

# Force a renderer: egl (NVIDIA) or osmesa (CPU). Empty picks automatically.
MUJOCO_GL=

# The Pulsar2 image you loaded (docker load -i ax_pulsar2_6.0.tar.gz).
PULSAR2_IMAGE=pulsar2:6.0
