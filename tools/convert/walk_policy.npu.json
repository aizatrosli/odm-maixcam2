{
  "model_type": "ONNX",
  "npu_mode": "NPU2",
  "quant": {
    "input_configs": [
      {
        "tensor_name": "obs",
        "calibration_dataset": "./calib_obs.tar",
        "calibration_size": -1,
        "calibration_format": "Numpy"
      }
    ],
    "calibration_method": "MinMax",
    "precision_analysis": true,
    "precision_analysis_method": "EndToEnd",
    "layer_configs": [
      {
        "start_tensor_names": ["DEFAULT"],
        "end_tensor_names": ["DEFAULT"],
        "data_type": "U16"
      }
    ]
  },
  "input_processors": [
    {
      "tensor_name": "obs",
      "src_dtype": "FP32"
    }
  ],
  "compiler": {
    "check": 3,
    "check_mode": "CheckOutput",
    "check_cosine_simularity": 0.99
  }
}
